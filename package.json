{
  "name": "djbooth.ai",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic DJ workflow for acquisition, analysis, stems, library management, and Rekordbox-compatible exports",
  "license": "UNLICENSED",
  "scripts": {
    "native:diagnostics": "pnpm --filter @gakonst/djbooth-apple diagnostics",
    "native:link": "pnpm --filter @gakonst/djbooth-apple run link",
    "build": "pnpm -r --workspace-concurrency=2 run build",
    "changeset": "changeset",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:version": "changeset version && pnpm plugin:build",
    "check": "pnpm validate",
    "djlink": "pnpm --filter @gakonst/djlink cli",
    "djbooth": "pnpm --filter @gakonst/djbooth cli",
    "djbooth:mcp": "pnpm --silent --filter @gakonst/djbooth exec tsx --tsconfig tsconfig.cli.json src/bin.ts --mcp",
    "djbooth:mcp:code": "pnpm --silent --filter @gakonst/djbooth exec tsx --tsconfig tsconfig.cli.json src/bin.ts --codemode-mcp",
    "djlink:lab": "cargo run --manifest-path rust/Cargo.toml -p djbooth-rs -- link",
    "djlink:native": "pnpm --filter @gakonst/djlink native:build",
    "format": "pnpm -r --if-present run format",
    "format:check": "pnpm -r --if-present run format:check",
    "lint": "pnpm -r --if-present run lint",
    "app": "pnpm --filter @gakonst/djbooth-app cli",
    "app:dev": "pnpm --filter @gakonst/djbooth-app dev",
    "native:dev": "pnpm --filter @gakonst/djbooth-apple dev",
    "native:ios": "pnpm --filter @gakonst/djbooth-apple ios",
    "native:device": "pnpm --filter @gakonst/djbooth-apple device",
    "native:check": "pnpm --filter @gakonst/djbooth-apple check",
    "native:test": "pnpm --filter @gakonst/djbooth-apple test",
    "native:test:ui": "pnpm --filter @gakonst/djbooth-apple test:ui",
    "native:test:usb": "pnpm --filter @gakonst/djbooth-apple test:usb",
    "library": "pnpm app",
    "library:dev": "pnpm app:dev",
    "site": "pnpm --filter @gakonst/djbooth-site build",
    "site:dev": "pnpm --filter @gakonst/djbooth-site dev",
    "music": "pnpm djbooth",
    "music:mcp": "pnpm djbooth:mcp",
    "music:mcp:code": "pnpm djbooth:mcp:code",
    "rekordbox": "pnpm --filter @gakonst/rekordbox cli",
    "rust:check": "cargo check --manifest-path rust/Cargo.toml --workspace --all-targets",
    "rust:format": "cargo +nightly fmt --manifest-path rust/Cargo.toml --all",
    "rust:format:check": "cargo +nightly fmt --manifest-path rust/Cargo.toml --all -- --check",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "plugin:build": "node scripts/build-djbooth-plugin.mjs",
    "plugin:check": "node scripts/build-djbooth-plugin.mjs --check",
    "slsk": "pnpm --filter slsk-ts cli",
    "soundcloud": "pnpm --filter @gakonst/soundcloud cli",
    "spots": "pnpm --filter @gakonst/spots cli",
    "test": "pnpm -r --workspace-concurrency=2 run test",
    "test:coverage": "pnpm build && pnpm -r --workspace-concurrency=2 --if-present run test:coverage",
    "test:pack": "node scripts/smoke-packed-clis.mjs",
    "tracks": "pnpm --filter @gakonst/tracks cli",
    "typecheck": "pnpm build && pnpm -r --workspace-concurrency=2 run typecheck",
    "usb": "pnpm --filter @gakonst/cdj-usb cli",
    "validate": "pnpm plugin:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "ytdlp": "pnpm --filter @gakonst/ytdlp-ts dev"
  },
  "devDependencies": {
    "@changesets/cli": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3-multiple-ciphers"
    ],
    "patchedDependencies": {
      "incur@0.4.13": "patches/incur@0.4.13.patch",
      "nanocodex@0.6.1": "patches/nanocodex@0.6.1.patch"
    }
  }
}
