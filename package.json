{
  "name": "@gakonst/ytdlp-ts",
  "version": "0.1.0",
  "description": "A TypeScript port of yt-dlp with an agent-native incur CLI",
  "type": "module",
  "private": true,
  "license": "Unlicense",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "ytdlp-ts": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "incur": "^0.4.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
