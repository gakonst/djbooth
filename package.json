{
  "name": "music-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript music metadata, acquisition, and DJ library workspace",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=2 run build",
    "changeset": "changeset",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:version": "changeset version",
    "check": "pnpm validate",
    "format": "pnpm -r --if-present run format",
    "format:check": "pnpm -r --if-present run format:check",
    "lint": "pnpm -r --if-present run lint",
    "music": "pnpm --filter @gakonst/music cli",
    "rekordbox": "pnpm --filter @gakonst/rekordbox cli",
    "slsk": "pnpm --filter slsk-ts cli",
    "soundcloud": "pnpm --filter @gakonst/soundcloud cli",
    "spots": "pnpm --filter @gakonst/spots cli",
    "test": "pnpm -r --workspace-concurrency=2 run test",
    "test:coverage": "pnpm build && pnpm -r --workspace-concurrency=2 --if-present run test:coverage",
    "test:pack": "node scripts/smoke-packed-clis.mjs",
    "tracks": "pnpm --filter @gakonst/tracks cli",
    "typecheck": "pnpm build && pnpm -r --workspace-concurrency=2 run typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "ytdlp": "pnpm --filter @gakonst/ytdlp-ts dev"
  },
  "devDependencies": {
    "@changesets/cli": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3-multiple-ciphers"
    ]
  }
}
