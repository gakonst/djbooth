{
  "name": "@gakonst/ytdlp-ts",
  "version": "0.2.0",
  "description": "A music-first TypeScript yt-dlp port with an agent-native incur CLI",
  "type": "module",
  "license": "Unlicense",
  "homepage": "https://github.com/gakonst/music-ts/tree/main/packages/ytdlp-ts#readme",
  "bugs": {
    "url": "https://github.com/gakonst/music-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gakonst/music-ts",
    "directory": "packages/ytdlp-ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ytdlp-ts": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "incur": "^0.4.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
