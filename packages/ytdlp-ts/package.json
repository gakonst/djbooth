{
  "name": "@gakonst/ytdlp-ts",
  "version": "0.3.0",
  "description": "A music-first TypeScript yt-dlp port with an agent-native incur CLI",
  "homepage": "https://github.com/gakonst/djbooth/tree/main/packages/ytdlp-ts#readme",
  "bugs": {
    "url": "https://github.com/gakonst/djbooth/issues"
  },
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/gakonst/djbooth",
    "directory": "packages/ytdlp-ts"
  },
  "bin": {
    "ytdlp-ts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "incur": "0.4.13",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
