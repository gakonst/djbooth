{
  "name": "@gakonst/tracks",
  "version": "0.2.0",
  "description": "Resolve DJ sets into enriched tracks and Rekordbox playlists",
  "license": "MIT",
  "author": "Georgios Konstantopoulos",
  "repository": {
    "type": "git",
    "url": "https://github.com/gakonst/djbooth",
    "directory": "packages/tracks-ts"
  },
  "bin": {
    "tracks": "./dist/cli.js",
    "tracks-ts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "cli": "tsx src/cli.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@gakonst/rekordbox": "workspace:*",
    "@gakonst/soundcloud": "workspace:*",
    "@gakonst/spots": "workspace:*",
    "@gakonst/ytdlp-ts": "workspace:*",
    "fast-xml-parser": "^5.10.0",
    "incur": "0.4.13",
    "slsk-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
