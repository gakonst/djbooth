[Unit]
Description=music-ts read-only CDJ USB appliance
After=local-fs.target
ConditionPathExists=/var/lib/music-cdj-usb/active.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/sbin/modprobe libcomposite
ExecStart=/usr/local/bin/music-cdj-usb attach
ExecStop=/usr/local/bin/music-cdj-usb detach --confirm-host-ejected
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
