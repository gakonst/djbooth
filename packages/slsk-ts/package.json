{
  "name": "slsk-ts",
  "version": "0.1.0",
  "description": "A complete, high-performance TypeScript client for the Soulseek network",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "slsk": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm check:types && pnpm lint && pnpm test:coverage",
    "check:types": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "lint": "oxlint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "tsx bench/protocol.ts"
  },
  "dependencies": {
    "incur": "^0.4.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "^4.0.18",
    "oxlint": "^1.50.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
