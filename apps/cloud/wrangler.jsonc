{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djbooth-library",
  "account_id": "16ce0442a940f01beefdb15a196a43ea",
  "main": "src/index.ts",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "vars": {
    "SHARED_LIBRARY_ACCOUNT": "nc_eaa692eb302d2bb39a228a3930a829e81aaf266da9e3cfb773ca5db95e98f4d5",
  },
  "compatibility_flags": ["nodejs_compat"],
  "services": [{ "binding": "CONNECT_API_SERVICE", "service": "nanocodex-connect-api" }],
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI" },
  "workflows": [
    {
      "name": "djbooth-download",
      "binding": "DOWNLOAD_WORKFLOW",
      "class_name": "DownloadWorkflow",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "PlaylistContainer",
      "image": "../../Dockerfile.playlist",
      "image_build_context": "../..",
      "instance_type": "standard-3",
      "max_instances": 5,
      "rollout_step_percentage": 100,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PLAYLIST_CONTAINERS", "class_name": "PlaylistContainer" },
      { "name": "AGENT_TOOLS", "class_name": "AgentTools" },
      { "name": "CREW_ROOMS", "class_name": "CrewRoom" },
    ],
  },
  "migrations": [
    { "tag": "playlist-containers-v1", "new_sqlite_classes": ["PlaylistContainer"] },
    { "tag": "agent-tools-v1", "new_sqlite_classes": ["AgentTools"] },
    { "tag": "crew-rooms-v1", "new_sqlite_classes": ["CrewRoom"] },
  ],
  "d1_databases": [
    {
      "binding": "LIBRARY_DB",
      "database_name": "djbooth-library",
      "database_id": "17ee62ff-a602-49a4-a35e-bd9316cabf13",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "djbooth-library-media" }],
}
