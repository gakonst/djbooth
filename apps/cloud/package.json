{
  "name": "@gakonst/djbooth-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:mcp": "node scripts/sync-mcp-catalog.mjs",
    "build": "pnpm build:client && wrangler deploy --dry-run --containers-rollout none --outdir dist",
    "dev": "wrangler dev",
    "deploy": "pnpm build:client && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply LIBRARY_DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply LIBRARY_DB --local",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt --write src test client package.json tsconfig.json wrangler.jsonc",
    "format:check": "oxfmt --check src test client package.json tsconfig.json wrangler.jsonc",
    "lint": "oxlint src test client",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs && vitest run test/*.test.ts",
    "build:container": "docker build --platform linux/amd64 -f ../../Dockerfile.playlist -t djbooth-playlist:dev ../..",
    "test:container": "docker run --rm --platform linux/amd64 --network none --entrypoint node --mount type=bind,source=\"$PWD/test/image-smoke.mjs\",target=/app/packages/djbooth/image-smoke.mjs,readonly djbooth-playlist:dev /app/packages/djbooth/image-smoke.mjs",
    "build:client": "vite build client --outDir ../public --emptyOutDir",
    "test:mobile-server": "pnpm build && node test/mobile/server.mjs",
    "test:container:provider": "docker run --rm --platform linux/amd64 --entrypoint node --mount type=bind,source=\"$PWD/test\",target=/fixtures,readonly --mount type=bind,source=\"$PWD/test/image-smoke.mjs\",target=/app/packages/djbooth/image-smoke.mjs,readonly djbooth-playlist:dev /app/packages/djbooth/image-smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@tanstack/react-query": "^5.101.4",
    "nanocodex": "0.6.6",
    "nanocodex-connect-embed": "file:../../vendor/nanocodex/nanocodex-connect-embed-0.1.0.tgz",
    "nanocodex-react": "file:../../vendor/nanocodex/nanocodex-react-0.1.0.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251117.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "miniflare": "^4.20251117.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.47.0"
  }
}
