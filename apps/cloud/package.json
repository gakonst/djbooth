{
  "name": "@gakonst/djbooth-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:mcp": "node scripts/sync-mcp-catalog.mjs",
    "build": "pnpm build:client && wrangler deploy --dry-run --containers-rollout none --outdir dist",
    "dev": "wrangler dev",
    "deploy": "pnpm build:client && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply LIBRARY_DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply LIBRARY_DB --local",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "format": "oxfmt --write src client package.json tsconfig.json wrangler.jsonc",
    "format:check": "oxfmt --check src client package.json tsconfig.json wrangler.jsonc",
    "lint": "oxlint src client",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json",
    "build:container": "docker build --platform linux/amd64 -f ../../Dockerfile.playlist -t djbooth-playlist:dev ../..",
    "build:client": "vite build client --outDir ../public --emptyOutDir && pnpm --filter @gakonst/djbooth-app build:cloud"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "nanocodex": "0.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251117.0",
    "miniflare": "^4.20251117.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "wrangler": "^4.47.0"
  }
}
