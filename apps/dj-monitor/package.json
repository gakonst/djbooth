{
  "name": "@gakonst/dj-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "format": "oxfmt --write src index.html vite.config.ts package.json tsconfig.json",
    "format:check": "oxfmt --check src index.html vite.config.ts package.json tsconfig.json",
    "lint": "oxlint src vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.186.1",
    "vgpu": "0.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@webgpu/types": "^0.1.74",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  }
}
