{
  "name": "@gakonst/djbooth-app",
  "version": "0.1.0",
  "description": "Local-first agentic DJ workstation by djbooth.ai",
  "license": "MIT",
  "author": "Georgios Konstantopoulos",
  "repository": {
    "type": "git",
    "url": "https://github.com/gakonst/djbooth",
    "directory": "apps/djbooth"
  },
  "bin": {
    "djbooth-app": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:client",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "cli": "tsx src/cli.ts",
    "dev": "tsx watch --clear-screen=false scripts/dev.ts",
    "dev:client": "vite --host 127.0.0.1",
    "desktop:build": "pnpm desktop:prepare && tauri build --config src-tauri/tauri.prod.conf.json",
    "desktop:dev": "tauri dev",
    "desktop:dmg": "pnpm desktop:prepare && tauri build --config src-tauri/tauri.prod.conf.json --bundles dmg",
    "desktop:prepare": "pnpm build && tsx scripts/prepare-desktop.ts",
    "format": "oxfmt --write src test scripts index.html vite.config.ts package.json tsconfig.json tsconfig.build.json README.md && cargo +nightly fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "oxfmt --check src test scripts index.html vite.config.ts package.json tsconfig.json tsconfig.build.json README.md && cargo +nightly fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "oxlint src test scripts vite.config.ts",
    "prepack": "pnpm build",
    "serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@gakonst/dj-monitor": "workspace:*",
    "@gakonst/rekordbox": "workspace:*",
    "@gakonst/soundcloud": "workspace:*",
    "@gakonst/spots": "workspace:*",
    "@gakonst/tracks": "workspace:*",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "incur": "0.4.13",
    "music-metadata": "11.13.0",
    "slsk-ts": "workspace:*",
    "ws": "8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.24.0",
    "nanocodex": "0.3.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wavesurfer.js": "7.12.10"
  },
  "engines": {
    "node": ">=22"
  }
}
