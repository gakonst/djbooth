# Cloudflare Containers require linux/amd64. Build the real clean-room analyzer.
FROM rust:1-bookworm AS native
RUN apt-get update && apt-get install -y --no-install-recommends libasound2-dev libudev-dev libssl-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY rust ./rust
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/build/rust/target cargo build --manifest-path rust/Cargo.toml --locked --release -p djbooth-rs && cp rust/target/release/djbooth-rs /djbooth-rs

FROM node:22-bookworm-slim AS engine
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY packages ./packages
COPY apps/djbooth ./apps/djbooth
COPY apps/dj-monitor ./apps/dj-monitor
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @gakonst/djbooth... --workspace-concurrency=2 run build
RUN pnpm --filter @gakonst/djbooth deploy --prod --legacy --config.allow-unused-patches=true /runtime

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libasound2 libudev1 libssl3 ca-certificates python3 && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:1fa6733c37ea6fb51c99ad8fe785e7b7e5f3246c9b980230329d4fb72ed8d4d6 https://github.com/yt-dlp/yt-dlp/releases/download/2026.08.19/yt-dlp /usr/local/lib/yt-dlp
# The official archive includes its JS challenge solver. Use the installed Node
# runtime explicitly, including when the typed bridge passes --ignore-config.
RUN printf '#!/bin/sh\nexec python3 /usr/local/lib/yt-dlp --js-runtimes node "$@"\n' > /usr/local/bin/yt-dlp && chmod 755 /usr/local/bin/yt-dlp
WORKDIR /app
COPY --from=engine /runtime /app
COPY --from=native /djbooth-rs /usr/local/bin/djbooth-rs
RUN chmod +x /app/dist/bin.js && ln -s /app/dist/bin.js /usr/local/bin/djbooth
ENV NODE_ENV=production
EXPOSE 8080
ENTRYPOINT ["djbooth", "cloud", "container", "--progress", "always", "--format", "json"]
