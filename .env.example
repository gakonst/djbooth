# Reference only. tracks does not auto-load .env files.
# Export/source values through your shell or secret manager.

# Metadata-first resolution ---------------------------------------------------

# ytdlp-ts executable or dist/cli.js. Leave empty for PATH/sibling discovery.
YTDLP_TS_PATH=

# Reference engine used by ytdlp-ts when native extraction needs fallback.
YTDLP_TS_REFERENCE_BINARY=yt-dlp

# Managed 1001Tracklists wrapper:
# https://parse.bot/marketplace/ec03e43b-6798-40ce-86c9-02832adedc4c/1001tracklists-com-api
PARSE_API_KEY=

# Optional: pin a subscribed scraper or replace the complete endpoint root.
PARSE_SCRAPER_ID=
PARSE_API_BASE=

# Recognition providers ------------------------------------------------------

# AudD Standard/Enterprise: https://dashboard.audd.io
AUDD_API_TOKEN=

# ACRCloud Identification: https://console.acrcloud.com
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# Local-file sampling only. Remote sets are never downloaded for sampling.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Sibling pipeline: individual acquisition ----------------------------------
# Consumed by slsk-ts/the orchestration skill, not by `tracks resolve`.

SLSK_USERNAME=
SLSK_PASSWORD=
SLSK_SERVER=server.slsknet.org:2242
SLSK_LISTEN_PORT=0

# Sibling pipeline: Spotify metadata/playlists -------------------------------
# Consumed by spots/the orchestration skill, not by `tracks resolve`.
# PKCE login needs only CLIENT_ID; client credentials need CLIENT_ID + SECRET.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback
SPOTIFY_ACCESS_TOKEN=
SPOTS_CREDENTIALS_PATH=

# Sibling pipeline: Rekordbox handoff ----------------------------------------
# Usually unnecessary: rekordbox-ts includes standard keys and auto-detection.

REKORDBOX_DB_KEY=
REKORDBOX_DEVICE_DB_KEY=
