# One workspace-root environment for every music-ts CLI.
# Uncomment optional settings only when overriding their built-in defaults.

# 1001Tracklists via Parse
PARSE_API_KEY=
# PARSE_API_BASE=
# PARSE_SCRAPER_ID=

# Spotify
SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback
# SPOTIFY_ACCESS_TOKEN=
# SPOTS_CREDENTIALS_PATH=

# SoundCloud
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:8788/callback
# SOUNDCLOUD_ACCESS_TOKEN=
# SOUNDCLOUD_CREDENTIALS_PATH=
# SOUNDCLOUD_CLIENT_CREDENTIALS_PATH=

# Optional recognition providers
# AUDD_API_TOKEN=
# ACR_HOST=
# ACR_ACCESS_KEY=
# ACR_ACCESS_SECRET=

# Optional Soulseek acquisition
SLSK_USERNAME=
SLSK_PASSWORD=
# SLSK_SERVER=server.slsknet.org:2242
# SLSK_LISTEN_PORT=0

# Canonical local recording library
# MUSIC_LIBRARY_ROOT=~/.djtools/tracks
